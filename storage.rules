rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "PASTE_YOUR_ADMIN_AUTH_UID";
    }
    match /certificates/{projectId}/{studentUid}/{fileName} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/.*)');
      allow read: if request.auth != null
        && (isAdmin() || request.auth.uid == studentUid);
    }
  }
}
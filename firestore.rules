rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "wmPUWhoSpycD4ReHIVvh8caDmfq2" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }
    function isApproved() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved";
    }
    function projectVisible(projectId) {
      return signedIn() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.visibility == "public" ||
        get(/databases/$(database)/documents/projects/$(projectId)).data.visibleTo.hasAny([request.auth.uid])
      );
    }
    function isGroupMember(groupId) {
      return signedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.status == "pending"
        && request.resource.data.role == "student";
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isApproved() && resource.data.status == "approved")
      );
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["name", "branch", "interestedIds"]));
      allow delete: if false; // Keep every user profile record permanently. Admin can only change status.

      match /certificates/{certificateId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if isAdmin();
      }
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || (isApproved() && projectVisible(projectId));
      allow create, update, delete: if isAdmin();

      match /responses/{studentId} {
        allow read: if isAdmin() ||
          (signedIn() && request.auth.uid == studentId && isApproved() && projectVisible(projectId));
        allow create: if signedIn() && request.auth.uid == studentId &&
          isApproved() && projectVisible(projectId) &&
          request.resource.data.uid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /groups/{groupId} {
      allow read: if isAdmin() || (isApproved() && isGroupMember(groupId));
      allow create: if isAdmin();
      allow update, delete: if isAdmin();

      match /callPeers/{peerId} {
        allow read: if isAdmin() || (isApproved() && isGroupMember(groupId));
        allow create, update: if signedIn() && isApproved() &&
          isGroupMember(groupId) && request.auth.uid == peerId;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == peerId);
      }

      match /signals/{signalId} {
        allow read: if isAdmin() || (isApproved() && isGroupMember(groupId));
        allow create: if signedIn() && isApproved() && isGroupMember(groupId) &&
          request.resource.data.from == request.auth.uid &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.members
            .hasAny([request.resource.data.to]);
        allow delete: if isAdmin() ||
          (signedIn() && resource.data.to == request.auth.uid);
        allow update: if false;
      }
    }
  }
}
